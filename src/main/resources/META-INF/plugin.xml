<!-- Zell language support. Grammar-Kit PSI for syntax; zell-lsp (platform LSP API) for semantics. -->
<idea-plugin>
    <id>org.zell.idea</id>
    <name>Zell</name>
    <vendor url="https://github.com/zell-lang/zell">Zell</vendor>

    <description><![CDATA[
    Support for the <a href="https://github.com/zell-lang/zell">Zell</a> programming language.
    <ul>
      <li>Syntax highlighting, brace matching, commenting, folding, structure view and Go to Symbol for <code>.zl</code> files</li>
      <li>The standard library (<code>zell env ZELL_STD</code>) attached as an external library</li>
      <li>In IntelliJ IDEA Ultimate, GoLand and other commercial IDEs: diagnostics, navigation, hover, completion,
          rename, code actions, semantic highlighting and formatting from the <code>zell-lsp</code> language server</li>
    </ul>
    ]]></description>

    <!-- Version range and change notes are patched in from gradle.properties by the Gradle build. -->

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <!-- The platform LSP API exists only in commercial IDEs; without it the plugin
         still loads (PSI features only). -->
    <depends optional="true" config-file="zell-lsp.xml">com.intellij.modules.ultimate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Zell" language="Zell" extensions="zl"
                  implementationClass="org.zell.idea.lang.ZellFileType" fieldName="INSTANCE"/>
        <lang.parserDefinition language="Zell" implementationClass="org.zell.idea.parser.ZellParserDefinition"/>

        <!-- Stub element types are fields of the generated interface ZellTypes; their
             external ids are "zell." + field name (ZellDeclStubElementType). -->
        <stubElementTypeHolder class="org.zell.idea.psi.ZellTypes" externalIdPrefix="zell."/>
        <stubIndex implementation="org.zell.idea.stubs.ZellDeclNameIndex"/>
        <gotoSymbolContributor implementation="org.zell.idea.stubs.ZellGotoSymbolContributor"/>

        <lang.syntaxHighlighterFactory language="Zell"
                                       implementationClass="org.zell.idea.highlighting.ZellSyntaxHighlighterFactory"/>
        <annotator language="Zell" implementationClass="org.zell.idea.highlighting.ZellHighlightingAnnotator"/>
        <colorSettingsPage implementation="org.zell.idea.highlighting.ZellColorSettingsPage"/>

        <lang.braceMatcher language="Zell" implementationClass="org.zell.idea.structure.ZellBraceMatcher"/>
        <lang.commenter language="Zell" implementationClass="org.zell.idea.structure.ZellCommenter"/>
        <lang.quoteHandler language="Zell" implementationClass="org.zell.idea.editor.ZellQuoteHandler"/>
        <spellchecker.support language="Zell" implementationClass="org.zell.idea.editor.ZellSpellcheckingStrategy"/>
        <indexPatternBuilder implementation="org.zell.idea.editor.ZellIndexPatternBuilder"/>
        <todoIndexer filetype="Zell" implementationClass="org.zell.idea.editor.ZellTodoIndexer"/>
        <breadcrumbsInfoProvider implementation="org.zell.idea.editor.ZellBreadcrumbsProvider"/>
        <lang.formatter language="Zell" implementationClass="org.zell.idea.formatter.ZellFormattingModelBuilder"/>
        <formattingService implementation="org.zell.idea.formatter.ZellFormattingService"/>
        <lang.foldingBuilder language="Zell" implementationClass="org.zell.idea.structure.ZellFoldingBuilder"/>
        <lang.psiStructureViewFactory language="Zell"
                                      implementationClass="org.zell.idea.structure.ZellStructureViewFactory"/>

        <additionalLibraryRootsProvider implementation="org.zell.idea.toolchain.ZellLibraryRootProvider"/>
        <applicationConfigurable parentId="language" id="org.zell.idea.toolchain"
                                 displayName="Zell"
                                 instance="org.zell.idea.toolchain.ZellToolchainConfigurable"/>

        <notificationGroup id="Zell" displayType="BALLOON"/>
        <editorNotificationProvider implementation="org.zell.idea.toolchain.ZellToolchainNotificationProvider"/>
        <fileIconProvider implementation="org.zell.idea.lang.ZellManifestIconProvider"/>

        <!-- Run, build and test (org.zell.idea.run) -->
        <configurationType implementation="org.zell.idea.run.ZellRunConfigurationType"/>
        <runConfigurationProducer implementation="org.zell.idea.run.ZellRunProducer"/>
        <runConfigurationProducer implementation="org.zell.idea.run.ZellTestProducer"/>
        <runLineMarkerContributor language="Zell" implementationClass="org.zell.idea.run.ZellRunLineMarkerContributor"/>
        <consoleFilterProvider implementation="org.zell.idea.run.ZellConsoleFilter$Provider"/>

        <!-- Templates (org.zell.idea.templates) -->
        <defaultLiveTemplates file="/liveTemplates/Zell.xml"/>
        <liveTemplateContext contextId="ZELL" implementation="org.zell.idea.templates.ZellTemplateContextType"/>
        <internalFileTemplate name="Zell File"/>
        <internalFileTemplate name="Zell Main"/>
        <internalFileTemplate name="Zell Test"/>
        <codeInsight.template.postfixTemplateProvider language="Zell"
                                                      implementationClass="org.zell.idea.templates.ZellPostfixTemplateProvider"/>
        <newProjectWizard.generator implementation="org.zell.idea.templates.ZellNewProjectWizard"/>
    </extensions>

    <actions>
        <action id="org.zell.idea.NewFile" class="org.zell.idea.templates.ZellCreateFileAction">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFromTemplate"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="org.zell.idea.toolchain.ZellLibraryRootProvider$ToolchainListener"
                  topic="org.zell.idea.toolchain.ZellToolchain$Listener"/>
        <listener class="org.zell.idea.toolchain.ZellToolchainNotificationProvider$ToolchainListener"
                  topic="org.zell.idea.toolchain.ZellToolchain$Listener"/>
    </applicationListeners>
</idea-plugin>
